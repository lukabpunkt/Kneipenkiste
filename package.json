{
  "name": "zoll",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Der Zoll — Mobile-First Pass-the-Phone-Bluffspiel",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,css,html,md}\"",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/flow.spec.ts",
    "test:perf": "playwright test tests/e2e/perf.spec.ts",
    "build:atlas": "node scripts/build-atlas.mjs",
    "build:audio": "node scripts/build-audio-sprite.mjs",
    "preview:sequences": "vite --host --open \"/?dev=1&panel=sequences\""
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "free-tex-packer-core": "^0.3.9",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
